<Application x:Class="LocalDictate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#111827"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
  </Application.Resources>
</Application>
