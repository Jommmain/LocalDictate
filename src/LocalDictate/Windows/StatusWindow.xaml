<Window x:Class="LocalDictate.Windows.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalDictate.Windows"
        Title="LocalDictate"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
  <StackPanel Margin="22,20,22,18">
    <TextBlock Text="LocalDictate" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="14"
               Text="Офлайн диктовка · русский и английский"/>

    <Border Margin="0,18,0,0" Padding="16,14" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18">
      <StackPanel>
        <TextBlock x:Name="StatusText" Text="Запуск…" FontSize="16" TextWrapping="Wrap"/>
        <local:WaveformControl x:Name="LiveWave" Height="52" Margin="0,14,0,0"/>
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                   Text="Правый Ctrl — начать и остановить запись"/>
      </StackPanel>
    </Border>

    <TextBlock Margin="6,18,0,8" Foreground="{DynamicResource MutedBrush}" FontSize="12"
               FontWeight="SemiBold" Text="Настройки"/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="18" Padding="4,2">
      <StackPanel>
        <Grid Margin="14,11">
          <TextBlock Text="Хоткей" VerticalAlignment="Center" FontSize="14"/>
          <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                     Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Text="Правый Ctrl"/>
        </Grid>
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="14,0"/>
        <Grid Margin="14,11">
          <TextBlock Text="Язык" VerticalAlignment="Center" FontSize="14"/>
          <TextBlock x:Name="LanguageValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
        </Grid>
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="14,0"/>
        <Grid Margin="14,11">
          <TextBlock Text="Офлайн" VerticalAlignment="Center" FontSize="14"/>
          <TextBlock x:Name="OfflineValue" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}" FontSize="14"/>
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock x:Name="PathsText" Margin="6,14,0,0" FontSize="12" TextWrapping="Wrap"
               Foreground="{DynamicResource MutedBrush}"/>

    <Button Content="Скрыть в трей" Margin="0,16,0,0" HorizontalAlignment="Right"
            Style="{StaticResource QuietButton}" Click="Hide_Click"/>
  </StackPanel>
</Window>
