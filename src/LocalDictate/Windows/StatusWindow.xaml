<Window x:Class="LocalDictate.Windows.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalDictate"
        Height="320" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="LocalDictate" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
               Text="Строго офлайн диктовка · RU / EN"/>

    <Border Grid.Row="2" Margin="0,18,0,0" Padding="14" Background="{StaticResource CardBrush}" CornerRadius="10">
      <StackPanel>
        <TextBlock x:Name="StatusText" Text="Запуск…" FontSize="15" TextWrapping="Wrap"/>
        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                   Text="Хоткей: правый Ctrl — старт / стоп записи"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,16,0,0">
      <TextBlock Foreground="{StaticResource MutedBrush}" Text="Данные"/>
      <TextBlock x:Name="PathsText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                 Foreground="{StaticResource MutedBrush}"/>
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Скрыть в трей" Padding="14,8" Click="Hide_Click"/>
    </StackPanel>
  </Grid>
</Window>
