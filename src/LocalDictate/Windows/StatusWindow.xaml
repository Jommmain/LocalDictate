<Window x:Class="LocalDictate.Windows.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalDictate.Windows"
        Title="LocalDictate"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">
  <StackPanel Margin="20,18,20,16">
    <TextBlock Text="LocalDictate" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="14"
               Text="Офлайн диктовка · русский и английский"/>

    <Border Margin="0,16,0,0" Padding="14,14" Style="{StaticResource GroupCard}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconWell}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border Width="8" Height="10" CornerRadius="4" Background="{DynamicResource AccentBrush}"/>
              <Border Width="2" Height="3" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
              <Border Width="10" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,0,0" Text="Запуск…"
                     FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Grid>
        <local:WaveformControl x:Name="LiveWave" Height="48" Margin="0,12,0,0"/>
        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                   Text="Правый Ctrl — начать и остановить запись"/>
      </StackPanel>
    </Border>

    <TextBlock Text="ЗАПИСЬ" Style="{StaticResource SectionLabel}"/>
    <Border Style="{StaticResource GroupCard}">
      <StackPanel>
        <Grid Margin="12,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconWell}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="3" Height="3" CornerRadius="0.8" Background="{DynamicResource AccentBrush}" Margin="0.6,0"/>
                <Border Width="3" Height="3" CornerRadius="0.8" Background="{DynamicResource AccentBrush}" Margin="0.6,0"/>
                <Border Width="3" Height="3" CornerRadius="0.8" Background="{DynamicResource AccentBrush}" Margin="0.6,0"/>
              </StackPanel>
              <Border Width="12" Height="3" CornerRadius="0.8" Background="{DynamicResource AccentBrush}" Margin="0,2,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock Grid.Column="1" Margin="12,0,8,0" Text="Хоткей" VerticalAlignment="Center" FontSize="15"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="15" Text="Правый Ctrl"/>
            <Path Margin="8,0,2,0" Width="7" Height="12" Stretch="Fill" VerticalAlignment="Center"
                  Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M1,1 L6,6 L1,11"/>
          </StackPanel>
        </Grid>
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="56,0,0,0"/>
        <Grid Margin="12,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource IconWell}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border Width="3" Height="8" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="1,0" VerticalAlignment="Center"/>
              <Border Width="3" Height="14" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="1,0" VerticalAlignment="Center"/>
              <Border Width="3" Height="10" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="1,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock Grid.Column="1" Margin="12,0,8,0" Text="Сигналы записи" VerticalAlignment="Center" FontSize="15"/>
          <CheckBox x:Name="SoundCuesBox" Grid.Column="2" VerticalAlignment="Center"
                    Style="{StaticResource SoftToggle}"
                    Checked="SoundCues_Changed" Unchecked="SoundCues_Changed"/>
        </Grid>
      </StackPanel>
    </Border>

    <TextBlock Text="РАСПОЗНАВАНИЕ" Style="{StaticResource SectionLabel}"/>
    <Border Style="{StaticResource GroupCard}">
      <Grid Margin="12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource IconWell}">
          <Grid Width="16" Height="16">
            <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"/>
            <Ellipse Width="6.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"/>
            <Border Height="1.4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="1,0"/>
          </Grid>
        </Border>
        <TextBlock Grid.Column="1" Margin="12,0,8,0" Text="Язык" VerticalAlignment="Center" FontSize="15"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="LanguageValue" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}" FontSize="15"/>
          <Path Margin="8,0,2,0" Width="7" Height="12" Stretch="Fill" VerticalAlignment="Center"
                Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Data="M1,1 L6,6 L1,11"/>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Text="ОФЛАЙН" Style="{StaticResource SectionLabel}"/>
    <Border Style="{StaticResource GroupCard}">
      <Grid Margin="12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource IconWellTeal}">
          <Grid Width="16" Height="16">
            <Ellipse Stroke="{DynamicResource AccentTealBrush}" StrokeThickness="1.6"/>
            <Border Width="1.6" Background="{DynamicResource AccentTealBrush}" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <RotateTransform Angle="-42"/>
              </Border.RenderTransform>
            </Border>
          </Grid>
        </Border>
        <TextBlock Grid.Column="1" Margin="12,0,8,0" Text="Офлайн режим" VerticalAlignment="Center" FontSize="15"/>
        <CheckBox x:Name="OfflineBox" Grid.Column="2" VerticalAlignment="Center"
                  Style="{StaticResource SoftToggle}"
                  Checked="Offline_Changed" Unchecked="Offline_Changed"/>
      </Grid>
    </Border>
    <TextBlock Margin="16,8,16,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
               Text="Модель и история только на этом компьютере."/>

    <TextBlock Text="ОБНОВЛЕНИЯ" Style="{StaticResource SectionLabel}"/>
    <Border Style="{StaticResource GroupCard}">
      <Grid Margin="12,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource IconWell}">
          <Path Width="14" Height="14" Stretch="Uniform"
                Data="M7,1 L7,8 M4,5 L7,8 L10,5 M2,11 L12,11" Stroke="{DynamicResource AccentBrush}"
                StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
          <TextBlock Text="Стабильный канал" FontSize="15"/>
          <TextBlock x:Name="UpdateStatusText" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"
                     Text="Релизы GitHub, вся папка программы."/>
        </StackPanel>
        <Button x:Name="UpdateButton" Grid.Column="2"
                Content="Проверить" Style="{StaticResource QuietButton}" VerticalAlignment="Center"
                Click="Update_Click"/>
      </Grid>
    </Border>

    <TextBlock x:Name="PathsText" Margin="16,14,16,0" FontSize="12" TextWrapping="Wrap"
               Foreground="{DynamicResource MutedBrush}"/>

    <Button Content="Скрыть в трей" Margin="0,16,0,0" HorizontalAlignment="Right"
            Style="{StaticResource QuietButton}" Click="Hide_Click"/>
  </StackPanel>
</Window>
