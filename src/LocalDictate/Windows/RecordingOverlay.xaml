<Window x:Class="LocalDictate.Windows.RecordingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalDictate.Windows"
        Title="LocalDictate"
        Width="280" Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeToContent="Manual">
  <Border x:Name="Root"
          Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1"
          CornerRadius="22"
          ClipToBounds="True"
          Padding="16,12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="PulseDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                 Fill="{DynamicResource AccentBrush}"/>
        <TextBlock x:Name="PhaseText" Text="Запись" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
      </StackPanel>
      <local:WaveformControl x:Name="Wave" Grid.Row="1" Margin="0,8,0,0" IsLive="True"/>
    </Grid>
  </Border>
</Window>
